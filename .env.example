# Gmail SMTP app password (Google Account -> Security -> App Passwords)
GMAIL_APP_PASSWORD=

# Google Sheet ID (the long id segment in the sheet's URL)
SHEET_ID=

# Gmail address the notifications are sent from (must match GMAIL_APP_PASSWORD's account)
EMAIL_SENDER=

# Artist name -> email mappings (keys referenced by email.artist_emails in config.yaml)
ARTIST_ANDREW_EMAIL=
ARTIST_SCOTT_EMAIL=
ARTIST_JASON_EMAIL=
ARTIST_CT_EMAIL=

# Fixed recipients by status (keys referenced by email.status_recipients in config.yaml)
REVIEW_RECIPIENT_1=
REVIEW_RECIPIENT_2=

DELIVERED_RECIPIENT_1=
DELIVERED_RECIPIENT_2=
